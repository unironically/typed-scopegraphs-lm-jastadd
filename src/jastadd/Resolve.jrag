aspect Resolve {

  inh lazy ArrayList<Scope> Scope.lex();
  coll ArrayList<VarScope>  Scope.var();
  coll ArrayList<ModScope>  Scope.mod();
  coll ArrayList<ModScope>  Scope.imp();

  //

  syn lazy ArrayList<VarScope> Scope.resolveLexImpVar(String lookup) {
    ArrayList<VarScope> res = new ArrayList<>();
    Boolean found = this.rxLexImpVar(lookup, res);
    return res;
  } 

  syn lazy Boolean Scope.rxLexImpVar(String lookup, ArrayList<VarScope> res) {

    Boolean foundVars = false;

    for (VarScope tgt: this.var())
      foundVars |= tgt.rxVar(lookup, res);

    if (foundVars) return true;

    for (ModScope tgt: this.imp())
      foundVars |= tgt.rxImpVar(lookup, res);

    if (foundVars) return true;

    for (Scope tgt: this.lex())
      foundVars |= tgt.rxLexImpVar(lookup, res);

    return foundVars;

  }

  syn lazy Boolean Scope.rxImpVar(String lookup, ArrayList<VarScope> res) {

    Boolean resolved = false;

    for (VarScope tgt: this.var())
      resolved |= tgt.rxVar(lookup, res);

    return resolved;

  }

  syn lazy Boolean VarScope.rxVar(String lookup, ArrayList<VarScope> res) {

    if (lookup.equals(this.getname())) {
      res.add(this);
      return true;
    }

    return false;
  
  }

}
