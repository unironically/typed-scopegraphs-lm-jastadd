abstract Scope ::= ;  // Default, built-in super scope type.
LexScope:Scope ::= ;  // 'scope type LexScope ->;'

abstract DclScope:Scope ::= <name:String>;  // 'abstract Scope type DclScope -> name::String'
VarScope:DclScope ::= <AstNode:Bind>;       // 'scope type VarScope -> AstNode::Decorated Bind', 'VarScope is DclScope'
ModScope:DclScope ::= <AstNode:Module>;     // 'scope type ModScope -> AstNode::Decorated Module', 'ModScope is DclScope'
