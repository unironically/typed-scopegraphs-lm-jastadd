import java.util.ArrayList;

aspect Scoping {
  
  /* In the abstract syntax for scopes, ModScope extends DclScope.
   * If we want two relations for ModScope, the second must be an interface in JastAdd.
   * However there is no clarity between the Scope type and RegionScope. We must
   * repeat the signatures of all attributes + methods for Scope in the RegionScope interface.
   * If RegionScope had a scope graphs supertype other than Scope, we would have to copy in
   * the signatures for those scope types too.
   */

  interface RegionScope {
    public ArrayList<RegionScope> lex();
    public ArrayList<VarScope> var();
    public ArrayList<ModScope> mod();
    public ArrayList<ModScope> imp();
    public ArrayList<VarScope> resolveLexImpVar(String lookup);
    public ArrayList<ModScope> resolveLexImpMod(String lookup);
    public Boolean rxLexImpLast(String lookup, ArrayList<Scope> res, Boolean isVarRes);
    public Boolean rxImpLast(String lookup, ArrayList<Scope> res, Boolean isVarRes);
  }

  // 'LexScope is RegionScope'
  LexScope implements RegionScope;

  // 'ModScope is RegionScope'
  ModScope implements RegionScope;

}

aspect Scoping {

  /* Equations defining scope graphs for LM and executing queries for variable
   * uses and import declarations.
   * The way we construct scope graphs here corresponds to a sequential C-like
   * scoping semantics - no forward referencing.
   */

  // Program

  syn nta lazy LexScope Program.glob() = new LexScope();
  eq Program.glob().lex() = new ArrayList<>();

  syn nta lazy LexScope Program.dummy() = new LexScope();
  eq Program.dummy().lex() = new ArrayList<>();

  eq Program.getds().s() = this.glob();
  eq Program.getds().s_mod() = this.dummy();

  syn lazy Boolean Program.ok() = this.getds().ok();

  /*
  prod Program ::= ds::Decls | glob::LexScope dummy::LexScope
  { glob = LexScope();
    dummy = LexScope();
    ds.s = glob;
    ds.s_mod = dummy;
    this.ok = ds.ok;
     }
  */

  // Decls

  inh lazy RegionScope Decls.s();
  inh lazy RegionScope Decls.s_mod();

  syn lazy Boolean Decls.ok() = false;

  // DeclsCons

  syn nta lazy LexScope DeclsCons.next() = new LexScope();
  eq DeclsCons.next().lex() {
    ArrayList<RegionScope> lex = new ArrayList<>();
    lex.add(this.s());
    return lex;
  }

  eq DeclsCons.getd().s() = this.s();
  eq DeclsCons.getd().s_def() = this.next();
  eq DeclsCons.getd().s_mod() = this.s_mod();

  eq DeclsCons.getds().s() = this.next();
  eq DeclsCons.getds().s_mod() = this.s_mod();

  syn lazy Boolean DeclsCons.ok() = this.getd().ok() && this.getds().ok();

  /*
  prod DeclsCons:Decls ::= d::Decl ds::Decls | next::LexScope
  { next = LexScope();
    next -[ `lex ]-> this.s;
    d.s = this.s;
    d.s_def = this.s_def;
    d.s_mod = this.s_mod;
    ds.s = this.next;
    ds.s_mod = this.s_mod;
    this.ok = d.ok && ds.ok; }
  */

  // DeclsNil

  syn lazy Boolean DeclsNil.ok() = true;

  /*
  prod DeclsNil:Decls ::=
  { this.ok = true; }
  */

  // Decl

  inh lazy RegionScope Decl.s();
  inh lazy RegionScope Decl.s_def();
  inh lazy RegionScope Decl.s_mod();
  syn lazy Boolean Decl.ok() = false;

  // DeclDef

  eq DeclDef.getb().s() = this.s();
  eq DeclDef.getb().s_def() = this.s_def();
  eq DeclDef.getb().s_mod() = this.s_mod();
  syn lazy Boolean DeclDef.ok() = this.getb().ok();

  /*
  prod DeclDef:Decl ::= b::Bind
  { b.s = this.s;
    b.s_def = this.s_def;
    b.s_mod = this.s_def;
    this.ok = b.ok; }
  */

  // DeclMod

  eq DeclMod.getm().s() = this.s();
  eq DeclMod.getm().s_def() = this.s_def();
  eq DeclMod.getm().s_mod() = this.s_mod();
  syn lazy Boolean DeclMod.ok() = this.getm().ok();

  /*
  prod DeclMod:Decl ::= m::Module
  { m.s = this.s;
    m.s_def = this.s_def;
    m.s_mod = this.s_def;
    this.ok = m.ok; }
  */

  // DeclImp

  eq DeclImp.getr().s() = this.s();
  eq DeclImp.getr().s_def() = this.s_def();
  eq DeclImp.getr().s_mod() = this.s_mod();
  syn lazy Boolean DeclImp.ok() = this.getr().ok();

  /*
  prod DeclImp:Decl ::= r::ModRef
  { r.s = this.s;
    r.s_def = this.s_def;
    r.s_mod = this.s_def;
    this.ok = r.ok; }
  */
  
  // Module

  inh lazy RegionScope Module.s();
  inh lazy RegionScope Module.s_def();
  inh lazy RegionScope Module.s_mod();

  syn nta lazy ModScope Module.s_newmod() = new ModScope(this.getid(), this);
  eq Module.s_newmod().lex() {
    ArrayList<RegionScope> lexTgts = new ArrayList<>();
    lexTgts.add(this.s());
    return lexTgts;
  }

  Module contributes
    this.s_newmod()
    to Scope.mod()
    for this.s_def();

  Module contributes
    this.s_newmod()
    to Scope.mod()
    for this.s_mod();

  syn lazy Boolean Module.ok() = this.getds().ok();

  eq Module.getds().s() = this.s();
  eq Module.getds().s_mod() = this.s_newmod();

  /*
  prod Module ::= ds::Decls | s_newmod::ModScope
  { s_newmod = ModScope(this.id, this);
    s_newmod   -[ `lex ]-> this.s; 
    this.s_def -[ `mod ]-> s_newmod;
    this.s_mod -[ `mod ]-> s_newmod;
    ds.s = this.s;
    ds.s_mod = s_newmod;
    this.ok = ds.ok; }
  */

  // Bind

  inh lazy RegionScope Bind.s();
  inh lazy RegionScope Bind.s_def();
  inh lazy RegionScope Bind.s_mod();

  syn nta lazy VarScope Bind.s_var() = new VarScope(this.getid(), this);
  eq Bind.s_var().lex() = new ArrayList<>();

  Bind contributes
    this.s_var()
    to Scope.var()
    for this.s_def();

  Bind contributes
    this.s_var()
    to Scope.var()
    for this.s_mod();

  eq Bind.gete().s() = this.s();

  syn lazy Boolean Bind.ok() = this.gete().ok();

  /*
  prod Bind ::= id::String ty::Type e::Expr | s_var::VarScope
  { s_var = VarScope(this.id, this);
    this.s_def -[ `var ]-> s_var;
    this.s_mod -[ `var ]-> s_var;
    e.s = this.s;
    this.ok = e.ok; }
  */

  // Expr

  inh lazy RegionScope Expr.s();
  syn lazy Boolean Expr.ok() = false;

  // ExprInt

  syn lazy Boolean ExprInt.ok() = true;

  /*
  prod ExprInt:Expr ::= i::Integer
  { this.ok = true; }
  */

  // ExprAdd

  syn lazy Boolean ExprAdd.ok() = this.getl().ok() && this.getr().ok();
  eq ExprAdd.getl().s() = this.s();
  eq ExprAdd.getr().s() = this.s();

  /*
  prod ExprAdd:Expr ::= l::Expr r::Expr
  { l.s = this.s;
    r.s = this.s;
    this.ok = l.ok && r.ok; }
  */

  // ExprVar

  eq ExprVar.getr().s() = this.s();
  syn lazy Boolean ExprVar.ok() = this.getr().ok();

  /*
  prod ExprVar:Expr ::= r::VarRef
  { r.s = this.s;
    this.ok = r.ok; }
  */

  // VarRef

  inh lazy RegionScope VarRef.s();

  syn lazy Boolean VarRef.ok() {
  
    ArrayList<VarScope> res = this.s().resolveLexImpVar(this.getid());
    Boolean found = res.size() > 0;

    if (found) {
      System.out.println(" - VarRef " + this.getid() + " on line " +
                        this.getStartLine() +
                        " resolves to a declaration on line " + 
                        res.get(0).getAstNode().getStartLine());
    } else {
      System.out.println("- Could not resolve VarRef " + this.getid() +
                         " on line " + this.getStartLine());
    }

    return found;

  }

  /*
  prod VarRef ::= id::String
  { this.ok = length(this.s.resolveLexImpVar(this.id)) > 0; }
  */

  // ModRef

  inh lazy RegionScope ModRef.s();
  inh lazy RegionScope ModRef.s_def();

  syn lazy Boolean ModRef.ok() = true;

  syn lazy ArrayList<ModScope> ModRef.impRes() {

    ArrayList<ModScope> res = this.s().resolveLexImpMod(this.getid());
    Boolean found = res.size() > 0;

    if (found) {
      System.out.println(" - ModRef " + this.getid() + " on line " +
                        this.getStartLine() +
                        " resolves to a declaration on line " + 
                        res.get(0).getAstNode().getStartLine());
    } else {
      System.out.println("- Could not resolve ModRef " + this.getid() +
                         " on line " + this.getStartLine());
    }

    return res;
  }

  ModRef contributes each
    this.impRes()
    to Scope.imp()
    for this.s_def();

  /*
  prod ModRef ::= id::String
  { this.impRes = this.s.resolveLexImpMod(this.id);
    this.s_def -[ `imp ]-> this.impRes; }
  */

}
